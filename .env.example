# All variables are optional.
#
# Without the Supabase pair the app runs in demo mode: everything works,
# but data is stored in the browser (localStorage) on that device only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Without a Google key the map falls back to Leaflet + free CARTO Voyager tiles.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Cloud map ID (enables vector maps / advanced markers).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
