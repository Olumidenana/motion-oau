# All variables are optional.
#
# With no backend configured the app runs in demo mode: everything works,
# but data is stored in the browser (localStorage) on that device only.

# Firebase (recommended, free Spark plan). Firebase → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local development only: use the Firebase emulators (e.g. 127.0.0.1).
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=

# Supabase (alternative backend; used only if Firebase isn't configured).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Without a Google key the map falls back to Leaflet + free CARTO Voyager tiles.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Cloud map ID (enables vector maps / advanced markers).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
